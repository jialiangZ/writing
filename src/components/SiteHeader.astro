---
import { ui, localeNames, type Locale } from "../i18n/ui";
import { localeUrl, tagsUrl, feedUrl } from "../lib/urls";

interface Props {
  locale: Locale;
  /** Alternate URLs of the current page in the other languages. */
  alternates?: { locale: Locale; href: string }[];
}

const { locale, alternates = [] } = Astro.props;
const t = ui[locale];

const nav = [
  { label: t.nav.home, href: localeUrl(locale) },
  { label: t.nav.tags, href: tagsUrl(locale) },
  { label: t.nav.rss, href: feedUrl(locale) },
];

const otherLocales = (Object.keys(localeNames) as Locale[]).map((code) => ({
  code,
  href: alternates.find((a) => a.locale === code)?.href ?? localeUrl(code),
}));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <p class="site-title"><a href={localeUrl(locale)}>{t.siteTitle}</a></p>
    <p class="site-tagline">{t.tagline}</p>

    <nav class="site-nav" aria-label={t.nav.home}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <span class="site-nav__lang">
        {
          otherLocales.map((item) => (
            <a
              href={item.href}
              hreflang={item.code}
              lang={item.code}
              aria-current={item.code === locale ? "true" : undefined}
            >
              {localeNames[item.code]}
            </a>
          ))
        }
      </span>
    </nav>
  </div>
</header>
