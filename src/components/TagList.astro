---
import { tagLabel } from "../i18n/tags";
import type { Locale } from "../i18n/ui";
import { tagUrl } from "../lib/urls";

interface Props {
  tags: string[];
  locale: Locale;
  /** Highlights the tag that is currently being viewed. */
  active?: string;
}

const { tags, locale, active } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list">
      {tags.map((tag) => (
        <li>
          <a
            class:list={["tag", { "tag--active": tag === active }]}
            href={tagUrl(locale, tag)}
          >
            {tagLabel(tag, locale)}
          </a>
        </li>
      ))}
    </ul>
  )
}
