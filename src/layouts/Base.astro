---
import "katex/dist/katex.min.css";
import "../styles/main.scss";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE } from "../config";
import { localeTags, ui, defaultLocale, type Locale } from "../i18n/ui";
import { absolute, feedUrl } from "../lib/urls";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Path of the current page, e.g. `/writing/zh/`. */
  canonical: string;
  /** Same page in the other languages. */
  alternates?: { locale: Locale; href: string }[];
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description,
  locale,
  canonical,
  alternates = [],
  type = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const t = ui[locale];
const canonicalUrl = absolute(canonical);
const ogImage = `${SITE.origin}/images/og-card.png`;
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonicalUrl} />

    {
      // The page declares its own language plus every translation of it.
      [{ locale, href: canonical }, ...alternates].map((entry) => (
        <link
          rel="alternate"
          hreflang={localeTags[entry.locale]}
          href={absolute(entry.href)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={absolute(
        locale === defaultLocale
          ? canonical
          : (alternates.find((alternate) => alternate.locale === defaultLocale)?.href ?? canonical),
      )}
    />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.siteTitle}
      href={absolute(feedUrl(locale))}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={t.siteTitle} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={localeTags[locale]} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <a class="skip-link" href="#main">{t.nav.home}</a>

    <SiteHeader locale={locale} alternates={alternates} />

    <main id="main" class="wrap wrap--narrow">
      <slot />
    </main>

    <SiteFooter locale={locale} />
  </body>
</html>
