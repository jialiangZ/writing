---
import Base from "../layouts/Base.astro";
import PostCard from "./PostCard.astro";
import { tagLabel } from "../i18n/tags";
import { ui, type Locale } from "../i18n/ui";
import { getPostsByTag, getTags } from "../lib/posts";
import { localeUrl, tagUrl, tagsUrl } from "../lib/urls";

interface Props {
  locale: Locale;
  tag: string;
}

const { locale, tag } = Astro.props;
const t = ui[locale];

const posts = await getPostsByTag(locale, tag);
const other: Locale = locale === "zh" ? "en" : "zh";
const otherTags = await getTags(other);
const hasOther = otherTags.some((entry) => entry.slug === tag);
const alternates = hasOther ? [{ locale: other, href: tagUrl(other, tag) }] : [];
---

<Base
  title={`${t.meta.tagPage}${tagLabel(tag, locale)} · ${t.siteTitle}`}
  description={t.tagline}
  locale={locale}
  canonical={tagUrl(locale, tag)}
  alternates={alternates}
>
  <h1 class="page-title">{tagLabel(tag, locale)}</h1>
  <p class="page-subtitle">
    <a href={tagsUrl(locale)}>← {t.nav.tags}</a> · <a href={localeUrl(locale)}>{t.nav.home}</a>
  </p>

  {
    posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <PostCard post={post} locale={locale} />
        ))}
      </ul>
    ) : (
      <p class="empty">{t.meta.emptyTag}</p>
    )
  }
</Base>
