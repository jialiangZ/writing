---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;

// The site has a single URL tree, so links always use the default locale.
const kindLabel =
  data.lang === "en"
    ? data.kind === "longform"
      ? "Essay"
      : "Note"
    : data.kind === "longform"
      ? "长文"
      : "笔记";
const showLangBadge = data.lang !== config.site.lang;
---

<li class="my-6">
  <a
    href={getPostUrl(id, filePath, config.site.lang)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(id)}>
      {title}
    </Heading>
  </a>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <Datetime {...props} lang={data.lang} />
    <span
      class="text-muted-foreground border-current rounded border px-1.5 py-0.5 text-xs opacity-70"
    >
      {kindLabel}
    </span>
    {
      showLangBadge && (
        <span class="text-muted-foreground text-xs tracking-wider opacity-60">
          {data.lang === "en" ? "EN" : "中文"}
        </span>
      )
    }
  </div>
  <p>{description}</p>
</li>
