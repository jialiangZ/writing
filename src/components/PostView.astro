---
import { render, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import TagList from "./TagList.astro";
import { ui, type Locale } from "../i18n/ui";
import { readingStats } from "../lib/reading-time";
import { getPosts, getTranslation, slugOf } from "../lib/posts";
import { postUrl } from "../lib/urls";

interface Props {
  post: CollectionEntry<"writing">;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = ui[locale];
const { data } = post;

const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const stats = readingStats(post.body);

const translation = await getTranslation(post);
const alternates = translation ? [{ locale: translation.locale, href: postUrl(translation.locale, slugOf(translation.post)) }] : [];

const all = await getPosts(locale);
const index = all.findIndex((entry) => entry.id === post.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

const dateFormat = locale === "zh" ? "zh-CN" : "en-US";
const dateLabel = data.pubDate.toLocaleDateString(dateFormat, {
  year: "numeric",
  month: locale === "zh" ? "long" : "short",
  day: "numeric",
});

const kindLabel = data.kind === "longform" ? t.sections.longform : t.sections.note;
---

<Base
  title={`${data.title} · ${t.siteTitle}`}
  description={data.description}
  locale={locale}
  canonical={postUrl(locale, slugOf(post))}
  alternates={alternates}
  type="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
>
  <article>
    <header class="post-header">
      <h1 class="post-header__title">{data.title}</h1>

      <div class="post-header__meta">
        <span class:list={["badge", { "badge--longform": data.kind === "longform" }]}>
          {kindLabel}
        </span>
        <time datetime={data.pubDate.toISOString()}>{dateLabel}</time>
        <span>{stats.minutes} {t.meta.readTime}</span>
        <span>{stats.words} {t.meta.words}</span>
        {
          data.updatedDate && (
            <span>
              {t.meta.updatedOn} {data.updatedDate.toLocaleDateString(dateFormat)}
            </span>
          )
        }
      </div>

      {data.tags.length > 0 && <div class="post-header__tags"><TagList tags={data.tags} locale={locale} /></div>}
    </header>

    {
      translation && (
        <p class="post-translation">
          <a href={postUrl(translation.locale, slugOf(translation.post))} hreflang={translation.locale}>
            {t.meta.translation}
          </a>
        </p>
      )
    }

    {
      toc.length > 2 && (
        <nav class="toc" aria-label={t.meta.toc}>
          <p class="toc__title">{t.meta.toc}</p>
          <ol>
            {toc.map((heading) => (
              <li style={heading.depth === 3 ? "margin-left:.8rem" : undefined}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="post-nav">
        <div>
          {older && (
            <a href={postUrl(locale, slugOf(older))}>
              <span class="post-nav__label">{t.meta.prev}</span>
              {older.data.title}
            </a>
          )}
        </div>
        <div style="text-align:right">
          {newer && (
            <a href={postUrl(locale, slugOf(newer))}>
              <span class="post-nav__label">{t.meta.next}</span>
              {newer.data.title}
            </a>
          )}
        </div>
      </nav>
    )
  }
</Base>
