---
import { ui } from "../i18n/ui";
import { localeUrl } from "../lib/urls";

const t = ui.zh;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · {t.siteTitle}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main id="main" class="wrap wrap--narrow">
      <h1 class="page-title">404</h1>
      <p class="page-subtitle">这个页面不存在，或者已经被移动。</p>
      <p class="back-home">
        <a href={localeUrl("zh")}>← {t.nav.home}</a> ·
        <a href={localeUrl("en")}>English</a>
      </p>
    </main>
  </body>
</html>
